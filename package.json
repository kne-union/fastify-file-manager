{
  "name": "@kne/fastify-file-manager",
  "version": "3.2.0",
  "description": "用于管理静态文件上传查看等",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "mocha tests/**/*.test.js --timeout 30000"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-file-manager.git"
  },
  "keywords": [],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-file-manager/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-file-manager#readme",
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@kne/fastify-aliyun": "^1.1.1",
    "@kne/fastify-group": "^0.2.5",
    "@kne/fastify-sequelize": "^3.2.0",
    "@napi-rs/canvas": "^1.1.0",
    "fastify": "^5.3.2",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.0.11",
    "mocha": "^11.7.5",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.2.5",
    "qs": "^6.12.3",
    "sharp": "^0.35.5",
    "sqlite3": "^5.1.7"
  },
  "peerDependencies": {
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "@napi-rs/canvas": ">=0.1",
    "fastify-plugin": ">=5",
    "ffmpeg-static": ">=5",
    "pdfjs-dist": ">=5",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@kne/fastify-group": "^0.2.5",
    "compressing": "^2.1.1",
    "fs-extra": "^11.2.0",
    "glob": "^13.0.0",
    "http-errors": "^2.0.0",
    "mime-types": "^3.0.2"
  }
}
